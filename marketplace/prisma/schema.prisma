// Banco de dados do marketplace.
// Desenvolvimento: SQLite (arquivo local). Produção: troque o provider para "postgresql"
// e defina DATABASE_URL com a URL do Postgres (ex.: Supabase, Neon, Railway).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("BUYER") // BUYER | ADMIN  (vendedor = usuário com Store)
  createdAt    DateTime @default(now())

  store  Store?
  orders Order[]
  quotes QuoteRequest[]
  reviews Review[]
}

model Store {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id])
  name           String
  slug           String   @unique
  kind           String   // EMPRESA | PROFISSIONAL
  document       String   // CNPJ ou CPF
  city           String
  bio            String
  credentials    String   @default("") // certificações, registros (ex.: autorização da PF)
  status         String   @default("PENDING") // PENDING | APPROVED | REJECTED | SUSPENDED
  verified       Boolean  @default(false)
  commissionRate Float    @default(0.12)
  createdAt      DateTime @default(now())

  listings   Listing[]
  orderItems OrderItem[]
  quotes     QuoteRequest[]
}

model Category {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  type     String    // PHYSICAL | SERVICE | DIGITAL | PROFESSIONAL
  icon     String
  listings Listing[]
}

model Listing {
  id           String   @id @default(cuid())
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id])
  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id])
  type         String   // PHYSICAL | SERVICE | DIGITAL | PROFESSIONAL
  title        String
  slug         String   @unique
  summary      String
  description  String
  specs        String   @default("[]") // JSON: [["Chave","Valor"], ...]
  priceCents   Int?     // null = sob orçamento
  priceUnit    String   @default("un") // un | hora | projeto | mês | licença
  requiresQuote Boolean @default(false)
  stock        Int?     // só produtos físicos
  status       String   @default("PENDING") // DRAFT | PENDING | ACTIVE | REJECTED
  rejectReason String?
  featured     Boolean  @default(false)
  createdAt    DateTime @default(now())

  orderItems OrderItem[]
  quotes     QuoteRequest[]
  reviews    Review[]
}

model Order {
  id            String   @id @default(cuid())
  code          String   @unique
  buyerId       String
  buyer         User     @relation(fields: [buyerId], references: [id])
  status        String   @default("PENDING_PAYMENT") // PENDING_PAYMENT | PAID | SHIPPED | COMPLETED | CANCELED
  totalCents    Int
  feeCents      Int      // soma das comissões da plataforma
  paymentMethod String   // PIX | CARTAO | BOLETO
  paymentRef    String?
  shipName      String
  shipAddress   String
  createdAt     DateTime @default(now())
  paidAt        DateTime?

  items OrderItem[]
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id])
  listingId      String
  listing        Listing @relation(fields: [listingId], references: [id])
  storeId        String
  store          Store   @relation(fields: [storeId], references: [id])
  title          String
  quantity       Int
  unitPriceCents Int
  commissionCents Int
  sellerNetCents Int
  fulfillment    String  @default("PENDING") // PENDING | SHIPPED | DELIVERED
  trackingCode   String?
}

model QuoteRequest {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id])
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  buyerId   String
  buyer     User     @relation(fields: [buyerId], references: [id])
  company   String   @default("")
  message   String
  reply     String?
  status    String   @default("OPEN") // OPEN | ANSWERED | CLOSED
  createdAt DateTime @default(now())
}

model Review {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rating    Int
  comment   String
  createdAt DateTime @default(now())

  @@unique([listingId, userId])
}
